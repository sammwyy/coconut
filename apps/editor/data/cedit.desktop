[Desktop Entry]
Type=Application
Name=CEdit
GenericName=Text Editor
Comment=Edit text, code, Markdown and binary files
Exec=cedit %F
Icon=accessories-text-editor
Terminal=false
Categories=Utility;TextEditor;Development;
MimeType=text/plain;text/markdown;text/x-markdown;text/x-log;text/x-rust;text/x-python;application/json;application/xml;application/x-shellscript;
Keywords=text;code;markdown;hex;binary;editor;
StartupNotify=true
