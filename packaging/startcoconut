#!/usr/bin/env bash
# startcoconut — Coconut session bootstrapper.
# Generated by install.sh; the window manager chosen at install time is baked
# in below. Rerun ./install.sh (or edit WM) to switch compositors.
WM="@COCONUT_WM@"
SESSION="@INSTALL_BIN@/coconut-session"

export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Coconut}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-Coconut}"
export XDG_SESSION_TYPE=wayland

export RUST_LOG="${RUST_LOG:-warn}"
export RUST_BACKTRACE="${RUST_BACKTRACE:-1}"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/coconut"
mkdir -p "$STATE_DIR"
LOGFILE="$STATE_DIR/session.log"

if [ -f "$LOGFILE" ]; then
    mv -f "$LOGFILE" "$LOGFILE.1"
fi

echo "--- startcoconut $(date) (wm=$WM, user=$USER, tty=$(tty 2>/dev/null)) ---" >>"$LOGFILE"

# TTY sessions need explicit activation for DRM master access.
if [ -n "$XDG_SESSION_ID" ] && command -v loginctl >/dev/null 2>&1; then
    loginctl activate "$XDG_SESSION_ID" 2>>"$LOGFILE" || true
fi

# Coconut needs a session bus (portals, MPRIS, IPC). Display managers provide
# one; bare TTY logins get wrapped.
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- "$0" "$@"
fi

# Wait until the compositor's Wayland socket exists. Prints the socket name.
wait_for_socket() {
    local dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    local sock
    for _ in $(seq 1 50); do
        for sock in "$dir"/wayland-*; do
            if [ -S "$sock" ]; then
                basename "$sock"
                return 0
            fi
        done
        sleep 0.1
    done
    return 1
}

case "$WM" in
    blair)
        # blair runs autostart commands from --run; the session launcher is
        # the session command so it never lands in blair's own config file.
        exec blair --run "\"$SESSION\"" >>"$LOGFILE" 2>&1
        ;;
    kwin_wayland|kwin)
        # The session app is started once the compositor is up; when it exits
        # the compositor (and therefore the session) exits too.
        exec kwin_wayland --exit-with-session "$SESSION" >>"$LOGFILE" 2>&1
        ;;
    *)
        # Generic recipe for compositors without a native session hook: start
        # the WM, wait for its socket, start the session launcher, and end
        # the session when either one dies.
        $WM >>"$LOGFILE" 2>&1 &
        wm_pid=$!
        socket="$(wait_for_socket)"
        if [ -z "$socket" ]; then
            echo "startcoconut: no Wayland socket appeared under $XDG_RUNTIME_DIR" >>"$LOGFILE"
            kill "$wm_pid" 2>/dev/null
            exit 1
        fi
        export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-$socket}"
        "$SESSION" >>"$LOGFILE" 2>&1 &
        session_pid=$!
        wait -n "$wm_pid" "$session_pid" 2>/dev/null
        kill "$wm_pid" "$session_pid" 2>/dev/null
        wait 2>/dev/null
        ;;
esac
